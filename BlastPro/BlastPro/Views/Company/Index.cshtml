@model BlastPro.Mvc.Models.ViewModels.CompanyViewModel
@{
    ViewData["Title"] = "Company";

    static string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0) return "?";
        var letters = parts.Length == 1 ? parts[0][..1] : parts[0][..1] + parts[^1][..1];
        return letters.ToUpperInvariant();
    }
}

<link rel="stylesheet" href="~/css/company.css" asp-append-version="true" />

<section class="container company-page">

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="company-layout">

        @* =====================================================
           COMPANY DETAILS
           ===================================================== *@

        <aside class="company-card company-profile">

            <div class="company-badges">
                <span class="company-badge badge-admin">Company admin</span>
            </div>

            <div class="company-icon" aria-hidden="true"><i class="bi bi-briefcase"></i></div>

            <h1 class="company-name">@Model.Name</h1>
            <p class="company-type">Blasting Company</p>

            <dl class="company-details">
                <div>
                    <dt>Registration number</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.RegistrationNumber) ? "Not supplied" : Model.RegistrationNumber)</dd>
                </div>
                <div>
                    <dt>Contact email</dt>
                    <dd>@Model.ContactEmail</dd>
                </div>
                <div>
                    <dt>Contact phone</dt>
                    <dd>@Model.ContactPhone</dd>
                </div>
                <div>
                    <dt>Address</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "Not supplied" : Model.Address)</dd>
                </div>
            </dl>

            <div class="company-profile-footer">
                <p>You have elevated permissions to add, edit and audit blasting contractors assigned to operations.</p>
                <a asp-action="Edit" class="company-btn company-btn-outline">Edit contact details</a>
            </div>

        </aside>


        @* =====================================================
           BLASTERS
           ===================================================== *@

        <div class="company-card company-blasters">

            <div class="company-blasters-header">
                <div>
                    <h2 class="company-blasters-title">Authorized Blasters</h2>
                    <p class="company-blasters-subtitle">Manage site blasters, certifications, and active contract profiles.</p>
                    <p class="company-seats" role="status">@Model.ActiveBlasterCount of @Model.BlasterLimit active Blasters</p>
                </div>

                @if (Model.ActiveBlasterCount < Model.BlasterLimit)
                {
                    <a asp-controller="Blasters" asp-action="Create" class="company-add-btn"><i class="bi bi-plus-lg"></i> Add New Blaster</a>
                }
                else
                {
                    <span class="company-seats-full">All seats are in use. Deactivate a Blaster to free a seat.</span>
                }
            </div>

            @if (Model.Blasters.Count == 0)
            {
                <div class="company-empty">No Blasters yet. Add your first Blaster account.</div>
            }
            else
            {
                <div class="blaster-table">

                    <div class="blaster-row blaster-head">
                        <div>Blaster name</div>
                        <div>Certification ID</div>
                        <div>Contact phone</div>
                        <div>Status</div>
                        <div class="blaster-actions-head">Actions</div>
                    </div>

                    @foreach (var blaster in Model.Blasters)
                    {
                        var status = !blaster.IsActive ? "Inactive" : blaster.EmailConfirmed ? "Active" : "Needs password";
                        var statusClass = !blaster.IsActive ? "inactive" : blaster.EmailConfirmed ? "active" : "invited";

                        <div class="blaster-row">

                            <div class="blaster-person">
                                <span class="blaster-avatar">@Initials(blaster.FullName)</span>
                                <span class="blaster-person-text">
                                    <span class="blaster-fullname">@blaster.FullName</span>
                                    <span class="blaster-email">@blaster.Email</span>
                                </span>
                            </div>

                            <div class="blaster-cell" data-label="Certification ID">@blaster.CertificationId</div>

                            <div class="blaster-cell blaster-phone" data-label="Contact phone">@blaster.PhoneNumber</div>

                            <div class="blaster-cell" data-label="Status">
                                <span class="blaster-status status-@statusClass">@status</span>
                            </div>

                            <div class="blaster-actions">
                                <a asp-controller="Blasters" asp-action="Edit" asp-route-id="@blaster.Id" class="company-btn company-btn-outline">Edit</a>
                                <a asp-controller="Blasters" asp-action="SetPassword" asp-route-id="@blaster.Id" class="company-btn company-btn-outline">Set password</a>

                                <form asp-controller="Blasters" asp-action="SetStatus" asp-route-id="@blaster.Id" method="post" class="d-flex m-0">
                                    <input type="hidden" name="isActive" value="@((!blaster.IsActive).ToString().ToLowerInvariant())" />
                                    <button class="company-btn company-btn-outline" type="submit">@(blaster.IsActive ? "Deactivate" : "Reactivate")</button>
                                </form>

                            </div>

                        </div>
                    }

                </div>
            }

            <p class="company-footnote">Active Blaster accounts reserve a seat. Deactivated Blasters keep their designs.</p>

        </div>

    </div>

</section>
