@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="container bp-page">
    <div class="bp-card bp-message">
        <i class="bi bi-exclamation-triangle bp-message-icon" aria-hidden="true"></i>
        <h1 class="bp-title mt-2">Something went wrong</h1>
        <p class="bp-subtitle">An error occurred while processing your request. Please try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="bp-subtitle">Request ID: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Dashboard" asp-action="Index" class="bp-btn bp-btn-primary">Back to Dashboard</a>
    </div>
</section>
