@model BlastPro.Mvc.Models.ViewModels.Projects.EditProjectViewModel

@{
    ViewData["Title"] = "Edit Project";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/create-project.css" asp-append-version="true" />


<div class="container create-project-page">

    <div class="create-project-card">

        <form asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>

            <input type="hidden" asp-for="Id" />

            <div class="create-project-header">

                <h2 class="create-project-title">
                    Edit Project
                </h2>

                <p class="create-project-subtitle">
                    Update the project details.
                </p>

            </div>

            <div class="create-project-body">

                <div asp-validation-summary="ModelOnly" class="create-validation-summary mb-3"></div>


                <div class="mb-4">

                    <label asp-for="Name" class="create-label"></label>

                    <input asp-for="Name"
                           class="form-control create-input"
                           placeholder="Enter project name"
                           autofocus />

                    <span asp-validation-for="Name" class="create-validation"></span>

                </div>


                <div class="mb-4">

                    <label asp-for="SiteLocation" class="create-label"></label>

                    <div class="create-input-wrapper">

                        <input asp-for="SiteLocation"
                               class="form-control create-input has-icon"
                               placeholder="e.g. Krugersdorp, Gauteng, ZA" />

                        <i class="bi bi-geo-alt create-input-icon"></i>

                    </div>

                    <span asp-validation-for="SiteLocation" class="create-validation"></span>

                </div>

                <div class="mb-2">

                    <label asp-for="BlastType" class="create-label"></label>

                    <select asp-for="BlastType" class="form-select create-select">

                        <option value="">Select a blast type</option>
                        <option value="Production">Production</option>
                        <option value="Pre-split">Pre-split</option>
                        <option value="Trim">Trim</option>
                        <option value="Development">Development</option>
                        <option value="Trench">Trench</option>

                    </select>

                    <span asp-validation-for="BlastType" class="create-validation"></span>

                </div>

            </div>

            <div class="create-project-footer">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="create-cancel-btn">

                    Cancel

                </a>

                <button type="submit" class="create-submit-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}