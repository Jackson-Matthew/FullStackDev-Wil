@model BlastPro.Mvc.Models.ViewModels.Projects.ProjectDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Project.Name} - Project";
    Layout = "_Layout";
}

<section class="container bp-page">

    <header class="bp-topbar">
        <div class="bp-topbar-main">
            <a asp-controller="Dashboard" asp-action="Index" class="bp-back-btn">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
            <h1 class="bp-title">@Model.Project.Name</h1>
        </div>

        <div class="bp-actions">
            <a asp-controller="ProjectNotes" asp-action="Index" asp-route-projectId="@Model.Project.Id" class="bp-btn bp-btn-sm bp-btn-dark">Notes</a>
            <a asp-action="Edit" asp-route-id="@Model.Project.Id" class="bp-btn bp-btn-sm">Edit</a>
            <a asp-controller="PatternDesign"
               asp-action="Index"
               asp-route-projectId="@Model.Project.Id"
               class="bp-btn bp-btn-sm bp-btn-primary">
                Pattern Design
            </a>
        </div>
    </header>

    <div class="bp-card mb-4">
        <div class="bp-card-header">
            <h2 class="bp-section-title">Project Details</h2>
        </div>
        <div class="bp-card-body">
            <dl class="bp-details">
                <div>
                    <dt>Site Location</dt>
                    <dd>@Model.Project.SiteLocation</dd>
                </div>
                <div>
                    <dt>Blast Type</dt>
                    <dd>@Model.Project.BlastType</dd>
                </div>
                <div>
                    <dt>Status</dt>
                    <dd>@Model.Project.Status</dd>
                </div>
                <div>
                    <dt>Rock Type</dt>
                    <dd>@(Model.Project.RockType ?? "Not set")</dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="bp-card">
        <div class="bp-card-header">
            <h2 class="bp-section-title">Hole Pattern</h2>
        </div>
        <div class="table-responsive">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>X (m)</th>
                        <th>Y (m)</th>
                        <th>Depth (m)</th>
                        <th>Charge (kg)</th>
                        <th>Stemming (m)</th>
                        <th>Delay (ms)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Holes.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="bp-empty">No holes have been added yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var hole in Model.Holes.OrderBy(h => h.Number))
                        {
                            <tr>
                                <td>@hole.Number</td>
                                <td>@hole.X</td>
                                <td>@hole.Y</td>
                                <td>@hole.Depth</td>
                                <td>@hole.Charge</td>
                                <td>@hole.Stemming</td>
                                <td>@hole.Delay</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</section>
