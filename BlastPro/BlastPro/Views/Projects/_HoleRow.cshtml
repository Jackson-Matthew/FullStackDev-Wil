@model BlastPro.Mvc.Models.ViewModels.Projects.BlastHoleViewModel
@using System.Globalization
@using BlastPro.Mvc.Models.ViewModels.Projects

@{
    var index = ViewData["HoleIndex"]?.ToString() ?? "0";
    var prefix = $"Holes[{index}]";
    var inv = CultureInfo.InvariantCulture;
    var aeciProducts = ViewData["AeciProducts"] as IReadOnlyList<AeciProductOptionViewModel>
        ?? Array.Empty<AeciProductOptionViewModel>();
}

<tr class="hole-row">

    @* Select *@
    <td class="col-select">
        <input type="checkbox"
               class="hole-checkbox hole-select"
               aria-label="Select hole @Model.Number" />
    </td>

    @* Hole Number *@
    <td class="col-number">
        <span class="hole-number">@Model.Number</span>
        <input type="hidden"
               name="@(prefix).Id"
               value="@Model.Id" />
        <input type="hidden"
               class="hole-number-input"
               name="@(prefix).Number"
               value="@Model.Number" />
    </td>

    @* X *@
    <td>
        <input type="number" step="0.01"
               class="cell-input"
               data-field="X"
               name="@(prefix).X"
               value="@Model.X.ToString("0.00", inv)" />
    </td>

    @* Y *@
    <td>
        <input type="number" step="0.01"
               class="cell-input"
               data-field="Y"
               name="@(prefix).Y"
               value="@Model.Y.ToString("0.00", inv)" />
    </td>

    @* Depth *@
    <td>
        <input type="number" step="0.1" min="0"
               class="cell-input"
               data-field="Depth"
               name="@(prefix).Depth"
               value="@Model.Depth.ToString("0.0", inv)" />
    </td>

    @* Hole diameter *@
    <td>
        <input type="number" step="0.1" min="0.1" max="1000"
               class="cell-input"
               data-field="DiameterMillimetres"
               name="@(prefix).DiameterMillimetres"
               value="@Model.DiameterMillimetres?.ToString("0.#", inv)" />
    </td>

    @* Subdrill *@
    <td>
        <input type="number" step="0.01" min="0"
               class="cell-input"
               data-field="SubdrillMetres"
               name="@(prefix).SubdrillMetres"
               value="@Model.SubdrillMetres?.ToString("0.##", inv)" />
    </td>

    @* Selected AECI explosive; retain a legacy company-product id until replaced. *@
    <td class="col-explosive">
        <input type="hidden" data-field="ExplosiveProductId"
               name="@(prefix).ExplosiveProductId" value="@Model.ExplosiveProductId" />
        <select class="form-select form-select-sm cell-select"
                data-field="AeciProductCode"
                name="@(prefix).AeciProductCode">
            <option value="">Select AECI product</option>
            @foreach (var group in aeciProducts.GroupBy(product => product.Series))
            {
                <optgroup label="@group.Key">
                    @foreach (var product in group)
                    {
                        <option value="@product.Code" selected="@(product.Code == Model.AeciProductCode)"
                                data-density-min="@product.DensityMinGramsPerCc?.ToString("0.###", inv)"
                                data-density-max="@product.DensityMaxGramsPerCc?.ToString("0.###", inv)"
                                data-energy-min="@product.EnergyMinMjPerKg.ToString("0.###", inv)"
                                data-energy-max="@product.EnergyMaxMjPerKg.ToString("0.###", inv)"
                                data-min-diameter="@product.MinimumDiameterMillimetres">@product.Name</option>
                    }
                </optgroup>
            }
        </select>
    </td>
    <td><input type="number" step="0.001" min="0.01" max="5"
               class="cell-input" data-field="ProductDensityGramsPerCc"
               name="@(prefix).ProductDensityGramsPerCc"
               value="@Model.ProductDensityGramsPerCc?.ToString("0.###", inv)" /></td>

    @* Charge *@
    <td>
        <input type="number" step="0.1" min="0"
               class="cell-input"
               data-field="Charge"
               name="@(prefix).Charge"
               value="@Model.Charge.ToString("0.0", inv)" />
    </td>

    @* Stemming *@
    <td>
        <input type="number" step="0.1" min="0"
               class="cell-input"
               data-field="Stemming"
               name="@(prefix).Stemming"
               value="@Model.Stemming.ToString("0.0", inv)" />
    </td>

    @* Delay *@
    <td>
        <input type="number" step="1" min="0"
               class="cell-input delay-input"
               data-field="Delay"
               name="@(prefix).Delay"
               value="@Model.Delay" />
    </td>

</tr>
