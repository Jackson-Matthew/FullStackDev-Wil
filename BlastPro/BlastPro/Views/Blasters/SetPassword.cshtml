@model BlastPro.Mvc.Models.ViewModels.BlasterPasswordViewModel
@{ ViewData["Title"] = "Set Blaster Password"; }

<link rel="stylesheet" href="~/css/company.css" asp-append-version="true" />

<section class="container blaster-form-page">
    <div class="company-card blaster-form-card">
        <div class="blaster-form-header">
            <a asp-controller="Company" asp-action="Index" class="blaster-back"><i class="bi bi-arrow-left"></i> Company</a>
            <h1 class="blaster-form-title">Set Blaster Password</h1>
            <p class="blaster-form-subtitle">@Model.Email</p>
        </div>
        <form asp-action="SetPassword" asp-route-id="@Model.Id" method="post" class="blaster-form-body">
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="blaster-summary" role="alert"></div>
            <div class="blaster-field">
                <label asp-for="Password" class="blaster-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="blaster-error"></span>
            </div>
            <div class="blaster-field">
                <label asp-for="ConfirmPassword" class="blaster-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="blaster-error"></span>
            </div>
            <div class="blaster-form-actions">
                <a asp-controller="Company" asp-action="Index" class="company-btn company-btn-outline blaster-cancel">Cancel</a>
                <button type="submit" class="company-add-btn"><i class="bi bi-check-lg"></i> Save password</button>
            </div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
