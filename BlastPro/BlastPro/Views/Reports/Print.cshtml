@model BlastPro.Mvc.Models.ViewModels.Reports.ReportViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Calculation report — @Model.ProjectName</title>
    <link rel="stylesheet" href="~/css/report.css" />
</head>
<body class="report-print-body">
    <div class="report-print-toolbar no-print">
        <button type="button" class="report-button report-button-primary" onclick="window.print()">Print / Save PDF</button>
        <span>Choose “Save as PDF” in the print dialog for a PDF copy.</span>
    </div>
    <main class="report-page">
        <partial name="_ReportBody" model="Model" />
    </main>
    <script>
        // Open the print dialog straight away; the button above prints again.
        window.addEventListener("load", function () { window.print(); });
    </script>
</body>
</html>
