@model BlastPro.Mvc.Models.ViewModels.Reports.ReportViewModel
@{
    ViewData["Title"] = Model.HasResults ? $"{Model.ProjectName} — Calculation Report" : "Reports";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/report.css" asp-append-version="true" />

<main class="report-page">
    @if (!Model.HasResults)
    {
        <div class="report-empty">
            <span class="report-eyebrow">Reports</span>
            <h1>@(Model.ProjectId > 0 ? Model.ProjectName : "Select a project")</h1>
            <p>@(Model.ProjectId > 0
                ? "This project has no saved calculation yet. Save its pattern draft, then calculate from Results."
                : "Choose a project on the dashboard to view its report.")</p>
            <div class="report-actions">
                @if (Model.ProjectId > 0)
                {
                    <a asp-controller="Results" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                       class="report-button report-button-primary">Open Results</a>
                }
                <a asp-controller="Dashboard" asp-action="Index" class="report-button">Dashboard</a>
            </div>
        </div>
    }
    else
    {
        <nav class="report-actions no-print" aria-label="Report actions">
            <a asp-controller="Results" asp-action="Index" asp-route-projectId="@Model.ProjectId"
               asp-route-resultId="@Model.ResultId" class="report-button">← Results</a>
            <a asp-controller="PatternDesign" asp-action="Index" asp-route-projectId="@Model.ProjectId"
               class="report-button">Pattern Design</a>
            <a asp-controller="Reports" asp-action="Print" asp-route-projectId="@Model.ProjectId"
               asp-route-resultId="@Model.ResultId" target="_blank" rel="noopener"
               class="report-button report-button-primary">Print / Save PDF</a>
        </nav>
        <partial name="_ReportBody" model="Model" />
    }
</main>
