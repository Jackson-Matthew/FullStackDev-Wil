@model BlastPro.Mvc.Models.ViewModels.Account.CreateCompanyViewModel
@{ ViewData["Title"] = "Create Company"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="container login-page setup-page">
    <div class="login-card">
        <h1 class="auth-title">Create Company</h1>
        <p class="auth-text">Set up your company and its first Main Company User. Confirm your email, then sign in to your Dashboard.</p>
        <form asp-action="CreateCompany" method="post">
            <div asp-validation-summary="All" class="login-validation-summary" role="alert"></div>
            <h2 class="h5 mt-3">Company details</h2>
            <div class="row">
                <div class="col-md-6 mb-3"><label asp-for="CompanyName" class="login-label"></label><input asp-for="CompanyName" class="form-control login-input" autocomplete="organization" /></div>
                <div class="col-md-6 mb-3"><label asp-for="RegistrationNumber" class="login-label"></label><input asp-for="RegistrationNumber" class="form-control login-input" /></div>
                <div class="col-md-6 mb-3"><label asp-for="ContactEmail" class="login-label"></label><input asp-for="ContactEmail" class="form-control login-input" /></div>
                <div class="col-md-6 mb-3"><label asp-for="ContactPhone" class="login-label"></label><input asp-for="ContactPhone" class="form-control login-input" /></div>
                <div class="col-12 mb-3"><label asp-for="Address" class="login-label"></label><textarea asp-for="Address" class="form-control login-input" rows="2"></textarea></div>
            </div>
            <h2 class="h5 mt-3">Main Company User</h2>
            <div class="mb-3"><label asp-for="FullName" class="login-label"></label><input asp-for="FullName" class="form-control login-input" autocomplete="name" /></div>
            <div class="mb-3"><label asp-for="Email" class="login-label"></label><input asp-for="Email" class="form-control login-input" autocomplete="username" /></div>
            <p class="auth-text">Use at least 8 characters, including uppercase and lowercase letters, a number and a symbol.</p>
            <div class="mb-3"><label asp-for="Password" class="login-label"></label><input asp-for="Password" class="form-control login-input" autocomplete="new-password" /></div>
            <div class="mb-3"><label asp-for="ConfirmPassword" class="login-label"></label><input asp-for="ConfirmPassword" class="form-control login-input" autocomplete="new-password" /></div>
            <button type="submit" class="sign-in-btn">Create Company</button>
        </form>
        <div class="auth-links"><a asp-action="Login" class="auth-link">Sign In</a></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
