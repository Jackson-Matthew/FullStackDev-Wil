@model BlastPro.Mvc.Models.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Set your password"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="container login-page"><div class="login-card">
    <h1 class="auth-title">Set your password</h1>
    <p class="auth-text">Complete your Blaster account for @Model.Email. Use at least 8 characters, including uppercase and lowercase letters, a number and a symbol.</p>
    <form asp-action="AcceptInvitation" method="post">
        <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
        <div asp-validation-summary="All" class="login-validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="Password" class="login-label"></label><input asp-for="Password" class="form-control login-input" autocomplete="new-password" /></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="login-label"></label><input asp-for="ConfirmPassword" class="form-control login-input" autocomplete="new-password" /></div>
        <button class="sign-in-btn" type="submit">Complete account setup</button>
    </form>
    <p class="auth-text mt-3">If your link expires, ask your company administrator for a new invitation.</p>
    <div class="auth-links"><a asp-action="Login" class="auth-link">Sign In</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
