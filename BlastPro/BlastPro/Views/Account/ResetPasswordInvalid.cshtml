@{
    ViewData["Title"] = "Invalid reset link";
}
<div class="container" style="max-width: 420px; margin-top: 80px;">
    <h2>Reset link unavailable</h2>
    <p>This reset link is incomplete or invalid. Please request a new link.</p>
    <a asp-action="ForgotPassword" class="btn btn-primary">Request a new link</a>
    <a asp-action="Login" class="d-block mt-3">Back to login</a>
</div>
