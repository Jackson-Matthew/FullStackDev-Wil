@{
    ViewData["Title"] = "Invalid reset link";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="container login-page">
    <div class="login-card">

        <div class="login-brand">
            <h1 class="login-logo"><span class="text-brand-red">Blast</span>Pro</h1>
            <p class="login-tagline">
                <span class="text-brand-red">Drill</span> and
                <span class="text-brand-red">Blast</span> Engineering Software
            </p>
        </div>

        <h2 class="auth-title">Reset link unavailable</h2>
        <p class="auth-text">This reset link is incomplete or invalid. Please request a new link.</p>

        <a asp-action="ForgotPassword" class="sign-in-btn">Request a new link</a>

        <div class="auth-links">
            <a asp-action="Login" class="auth-link">Back to login</a>
        </div>

    </div>
</div>