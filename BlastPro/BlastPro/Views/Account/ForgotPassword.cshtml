@model BlastPro.Mvc.Models.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="container login-page">
    <div class="login-card">

        <div class="login-brand">
            <h1 class="login-logo"><span class="text-brand-red">Blast</span>Pro</h1>
            <p class="login-tagline">
                <span class="text-brand-red">Drill</span> and
                <span class="text-brand-red">Blast</span> Engineering Software
            </p>
        </div>

        <h2 class="auth-title">Forgot Password</h2>
        <p class="auth-text">Enter your email to request a password reset link.</p>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="login-validation-summary mb-3"></div>

            <div class="mb-4">
                <label asp-for="Email" class="login-label"></label>
                <div class="login-input-wrapper">
                    <i class="bi bi-envelope login-input-icon"></i>
                    <input asp-for="Email"
                           class="form-control login-input"
                           placeholder="example@something.com"
                           autofocus />
                </div>
                <span asp-validation-for="Email" class="login-validation"></span>
            </div>

            <button type="submit" class="sign-in-btn">Request reset link</button>

            <div class="auth-links">
                <a asp-action="Login" asp-controller="Account" class="auth-link">Back to login</a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}