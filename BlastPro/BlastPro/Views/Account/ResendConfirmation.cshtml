@model BlastPro.Mvc.Models.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Request confirmation"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="container login-page"><div class="login-card">
    <h1 class="auth-title">Request a confirmation link</h1>
    <form asp-action="ResendConfirmation" method="post">
        <div asp-validation-summary="All" class="login-validation-summary" role="alert"></div>
        <div class="mb-3"><label asp-for="Email" class="login-label"></label><input asp-for="Email" class="form-control login-input" autocomplete="email" /></div>
        <button class="sign-in-btn" type="submit">Request link</button>
    </form>
    <div class="auth-links"><a asp-action="Login" class="auth-link">Sign In</a></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
