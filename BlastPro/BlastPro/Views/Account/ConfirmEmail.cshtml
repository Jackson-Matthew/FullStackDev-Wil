@model BlastPro.Mvc.Models.ViewModels.Account.EmailTokenViewModel
@{ ViewData["Title"] = "Confirm Email"; }
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<div class="container login-page"><div class="login-card">
    <h1 class="auth-title">Confirm your email</h1>
    <p class="auth-text">Confirm @Model.Email to enable sign-in.</p>
    <form asp-action="ConfirmEmail" method="post">
        <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
        <button class="sign-in-btn" type="submit">Confirm email</button>
    </form>
</div></div>
