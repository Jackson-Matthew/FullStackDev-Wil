@{
    ViewData["Title"] = "Check your email";
    Layout = "_Layout";
}

<div class="container" style="max-width: 420px; margin-top: 80px;">
    <div class="card shadow-sm">
        <div class="card-body p-4 text-center">
            <h2 class="mb-3">Check your email</h2>
            <p class="text-muted">
                If an account with that address exists, we've sent a password reset link.
            </p>
            <a asp-action="Login" asp-controller="Account" class="btn btn-primary mt-3">
                Back to login
            </a>
        </div>
    </div>
</div>