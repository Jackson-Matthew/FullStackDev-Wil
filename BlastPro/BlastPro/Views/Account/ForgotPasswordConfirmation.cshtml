@{
    ViewData["Title"] = "Reset request received";
    Layout = "_Layout";
}

<div class="container" style="max-width: 420px; margin-top: 80px;">
    <div class="card shadow-sm">
        <div class="card-body p-4 text-center">
            <h2 class="mb-3">Reset request received</h2>
            <p class="text-muted">
                If an eligible account exists, a reset link has been requested.
            </p>
            @if (ViewData["DevelopmentResetDelivery"] is true)
            {
                <div class="alert alert-info" role="status">
                    Local development: no email is sent. The reset message is saved in the API project's
                    <code>App_Data/PasswordReset</code> folder. Open the latest message for your address
                    and follow its link. Ask the developer if you cannot access this folder.
                </div>
            }
            <a asp-action="Login" asp-controller="Account" class="btn btn-primary mt-3">
                Back to login
            </a>
        </div>
    </div>
</div>
