@{
    ViewData["Title"] = "Reset request received";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="container login-page">
    <div class="login-card">

        <div class="login-brand">
            <h1 class="login-logo"><span class="text-brand-red">Blast</span>Pro</h1>
            <p class="login-tagline">
                <span class="text-brand-red">Drill</span> and
                <span class="text-brand-red">Blast</span> Engineering Software
            </p>
        </div>

        <h2 class="auth-title">Reset request received</h2>
        <p class="auth-text">If an eligible account exists, a reset link has been requested.</p>

        @if (ViewData["DevelopmentResetDelivery"] is true)
        {
            <div class="alert login-notice" role="status">
                Local development: no email is sent. The reset message is saved in the API project's
                <code>App_Data/PasswordReset</code> folder. Open the latest message for your address
                and follow its link. Ask the developer if you cannot access this folder.
            </div>
        }

        <a asp-action="Login" asp-controller="Account" class="sign-in-btn mt-3">Back to login</a>

    </div>
</div>