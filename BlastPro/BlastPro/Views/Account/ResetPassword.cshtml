@model BlastPro.Mvc.Models.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="container login-page">
    <div class="login-card">

        <div class="login-brand">
            <h1 class="login-logo"><span class="text-brand-red">Blast</span>Pro</h1>
            <p class="login-tagline">
                <span class="text-brand-red">Drill</span> and
                <span class="text-brand-red">Blast</span> Engineering Software
            </p>
        </div>

        <h2 class="auth-title">Reset Password</h2>
        <p class="auth-text">
            Use at least 8 characters, including uppercase and lowercase letters, a number and a symbol.
        </p>

        <form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate>
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="login-validation-summary mb-3"></div>

            @* New Password *@
            <div class="mb-4">
                <label asp-for="Password" class="login-label"></label>
                <div class="login-input-wrapper">
                    <i class="bi bi-lock login-input-icon"></i>
                    <input asp-for="Password"
                           class="form-control login-input"
                           placeholder="Enter a new password"
                           autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-target="Password" title="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="login-validation"></span>
            </div>

            @* Confirm Password *@
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="login-label"></label>
                <div class="login-input-wrapper">
                    <i class="bi bi-lock login-input-icon"></i>
                    <input asp-for="ConfirmPassword"
                           class="form-control login-input"
                           placeholder="Confirm your new password"
                           autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-target="ConfirmPassword" title="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="login-validation"></span>
            </div>

            <button type="submit" class="sign-in-btn">Reset password</button>
        </form>

        <div class="auth-links">
            <a asp-action="ForgotPassword" class="auth-link">Request a new reset link</a>
            <span aria-hidden="true"> · </span>
            <a asp-action="Login" class="auth-link">Back to login</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}