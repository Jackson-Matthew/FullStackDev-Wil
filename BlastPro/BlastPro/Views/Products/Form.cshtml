@model BlastPro.Mvc.Models.ViewModels.ProductFormViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add product" : "Edit product"; }
<section class="container py-4">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="Save" method="post" class="col-lg-6">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-warning"></span></div>
        <div class="mb-3"><label asp-for="AeciProductCode" class="form-label"></label>
            <select asp-for="AeciProductCode" class="form-select">
                <option value="">Custom product for older designs only</option>
                @foreach (var product in Model.Catalog) { <option value="@product.Code">@product.Name</option> }
            </select>
            <p class="form-text text-white">Select the matching AECI product so current pattern designs use this price.</p>
        </div>
        <div class="mb-3"><label asp-for="PricePerKg" class="form-label"></label><input asp-for="PricePerKg" type="number" min="0.01" max="1000000" step="0.01" class="form-control" /><span asp-validation-for="PricePerKg" class="text-warning"></span></div>
        <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Available for new designs</label></div>
        <button type="submit" class="btn btn-danger">Save product</button>
        <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
