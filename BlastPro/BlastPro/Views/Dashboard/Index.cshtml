@model List<BlastPro.Mvc.Models.Dtos.ProjectSummaryDto>

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<style>

    .dashboard-page {
        padding-top: 30px;
        padding-bottom: 40px;
    }

    .new-project-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 42px;
        background-color: #FF0000;
        border: 1px solid #FF0000;
        color: #FFFFFF;
        padding: 0 18px;
        border-radius: 5px;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .new-project-btn:hover {
            background-color: #CC0000;
            border-color: #CC0000;
            color: #FFFFFF;
        }

    .project-filters {
        background-color: #FFFFFF;
        border: 1px solid #000000;
        border-radius: 6px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .filter-label {
        color: #000000;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .project-search,
    .project-status {
        background-color: #FFFFFF;
        border: 1px solid #000000;
        color: #000000;
        min-height: 42px;
        border-radius: 5px;
    }

        .project-search::placeholder {
            color: #888888;
        }

        .project-search:focus,
        .project-status:focus {
            background-color: #FFFFFF;
            color: #000000;
            border-color: #FF0000;
            box-shadow: 0 0 0 0.15rem rgba(255, 0, 0, 0.2);
        }

        .project-status option {
            background-color: #FFFFFF;
            color: #000000;
        }

    .projects-card {
        background-color: #FFFFFF;
        border: 1px solid #000000;
        border-radius: 6px;
        overflow: hidden;
    }

    .projects-card-header {
        background-color: #FFFFFF;
        border-bottom: 1px solid #000000;
        padding: 15px 20px;
        color: #000000;
        font-weight: 600;
    }

    .project-header {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 120px;
        align-items: center;
        padding: 14px 20px;
        background-color: #EDEDED;
        border-bottom: 1px solid #000000;
        color: #000000;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .project-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 120px;
        align-items: center;
        padding: 18px 20px;
        background-color: #FFFFFF;
        border-bottom: 1px solid #000000;
        transition: background-color 0.2s ease;
    }

        .project-row:last-child {
            border-bottom: none;
        }

        .project-row:hover {
            background-color: #F5F5F5;
        }

    .project-name {
        color: #000000;
        font-weight: 500;
        text-decoration: none;
    }

        .project-name:hover {
            color: #FF0000;
        }

    .project-date {
        color: #000000;
        font-size: 0.9rem;
    }

    .project-status-badge {
        display: inline-block;
        width: fit-content;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .status-reviewed {
        background-color: #000000;
        color: #FFFFFF;
        border: 1px solid #000000;
    }

    .status-draft {
        background-color: #FFFFFF;
        color: #000000;
        border: 1px solid #000000;
    }

    .project-actions {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .project-action {
        background: none;
        border: none;
        padding: 4px;
        color: #000000;
        font-size: 1.15rem;
        text-decoration: none;
        transition: color 0.2s ease;
        cursor: pointer;
    }

        .project-action.view:hover {
            color: #FF0000;
        }

        .project-action.delete {
            color: #000000;
        }

            .project-action.delete:hover {
                color: #FF0000;
            }

    .no-projects {
        padding: 40px 20px;
        text-align: center;
        color: #000000;
    }

    .dashboard-error {
        background-color: #111111;
        border: 1px solid #FF0000;
        color: #FFFFFF;
    }

</style>


<div class="container dashboard-page">


    @if (ViewData["Error"] != null)
    {
        <div class="alert dashboard-error">
            @ViewData["Error"]
        </div>
    }


    @if (ViewData["Error"] == null)
    {

        <div class="project-filters">

            <div class="row g-3">

                <div class="col-md-6">

                    <label for="projectSearch"
                           class="filter-label">

                        Search Projects

                    </label>

                    <input type="text"
                           id="projectSearch"
                           class="form-control project-search"
                           placeholder="Search by project name..." />

                </div>


                <div class="col-md-3">

                    <label for="statusFilter"
                           class="filter-label">

                        Status

                    </label>

                    <select id="statusFilter"
                            class="form-select project-status">

                        <option value="all">
                            All Statuses
                        </option>

                        <option value="reviewed">
                            Reviewed
                        </option>

                        <option value="draft">
                            Draft
                        </option>

                    </select>

                </div>


                <div class="col-md-3 d-flex align-items-end">

                    <a class="new-project-btn"
                       asp-controller="Projects"
                       asp-action="Create">

                        + New Blast Project

                    </a>

                </div>

            </div>

        </div>

        <div class="projects-card">

            <div class="projects-card-header">
                Current Blast Designs
            </div>

            <div class="project-header">

                <div>
                    Project Name
                </div>

                <div>
                    Date Created
                </div>

                <div>
                    Status
                </div>

                <div>
                    Actions
                </div>

            </div>


            @if (!Model.Any())
            {
                <div class="no-projects">

                    No projects yet.

                    <br />

                    Click
                    <strong>New Blast Project</strong>
                    to get started.

                </div>
            }
            else
            {

                <div id="projectList">

                    @foreach (var p in Model)
                    {
                        <div class="project-row"
                             data-project-name="@p.Name.ToLower()"
                             data-project-status="@p.Status.ToLower()">

                            <div>

                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="project-name">

                                    @p.Name

                                </a>

                            </div>

                            <div class="project-date">
                            </div>

                            <div>

                                @if (p.Status?.ToLower() == "reviewed")
                                {
                                    <span class="project-status-badge status-reviewed">
                                        Reviewed
                                    </span>
                                }
                                else
                                {
                                    <span class="project-status-badge status-draft">
                                        Draft
                                    </span>
                                }

                            </div>

                            <div class="project-actions">

                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="project-action view"
                                   title="View Project">

                                    <i class="bi bi-arrow-right"></i>

                                </a>

                                <form asp-controller="Projects"
                                      asp-action="Delete"
                                      asp-route-id="@p.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this project?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="project-action delete"
                                            title="Delete Project">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>

                <div id="noSearchResults"
                     class="no-projects"
                     style="display: none;">

                    No projects match your search.

                </div>
            }

        </div>

    }

</div>

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const searchInput =
            document.getElementById("projectSearch");

        const statusFilter =
            document.getElementById("statusFilter");

        const projectRows =
            document.querySelectorAll(".project-row");

        const noSearchResults =
            document.getElementById("noSearchResults");

        if (!searchInput || !statusFilter) {
            return;
        }


        function filterProjects() {

            const searchValue =
                searchInput.value.toLowerCase().trim();

            const statusValue =
                statusFilter.value.toLowerCase();

            let visibleProjects = 0;


            projectRows.forEach(function(row) {

                const projectName =
                    row.getAttribute("data-project-name");

                const projectStatus =
                    row.getAttribute("data-project-status");


                const matchesSearch =
                    projectName.includes(searchValue);


                const matchesStatus =
                    statusValue === "all" ||
                    projectStatus === statusValue;


                if (matchesSearch && matchesStatus) {

                    row.style.display = "";

                    visibleProjects++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (noSearchResults) {

                if (visibleProjects === 0) {

                    noSearchResults.style.display = "block";

                }
                else {

                    noSearchResults.style.display = "none";

                }

            }

        }
        searchInput.addEventListener(
            "input",
            filterProjects
        );

        statusFilter.addEventListener(
            "change",
            filterProjects
        );

    });

</script>