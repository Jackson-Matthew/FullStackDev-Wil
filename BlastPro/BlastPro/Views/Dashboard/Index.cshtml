@model List<BlastPro.Mvc.Models.Dtos.ProjectSummaryDto>

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />


<div class="container dashboard-page">

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (ViewData["Error"] != null)
    {
        <div class="alert dashboard-error">
            @ViewData["Error"]
        </div>
    }


    @if (ViewData["Error"] == null)
    {

        <div class="project-filters">

            <div class="row g-3">

                <div class="col-md-6">

                    <label for="projectSearch"
                           class="filter-label">

                        Search Projects

                    </label>

                    <input type="text"
                           id="projectSearch"
                           class="form-control project-search"
                           placeholder="Search by project name..." />

                </div>


                <div class="col-md-3">

                    <label for="statusFilter"
                           class="filter-label">

                        Status

                    </label>

                    <select id="statusFilter"
                            class="form-select project-status">

                        <option value="all">
                            All Statuses
                        </option>

                        <option value="reviewed">
                            Reviewed
                        </option>

                        <option value="draft">
                            Draft
                        </option>

                        <option value="active">
                            Active
                        </option>

                        <option value="calculated">
                            Calculated
                        </option>

                        <option value="archived">
                            Archived
                        </option>

                    </select>

                </div>


                <div class="col-md-3 d-flex align-items-end">

                    <a class="new-project-btn"
                       asp-controller="Projects"
                       asp-action="Create">

                        + New Blast Project

                    </a>

                </div>

            </div>

        </div>

        <div class="projects-card">

            <div class="projects-card-header">
                Current Blast Designs
            </div>

            <div class="project-header project-header-five">

                <div>
                    Project Name
                </div>

                <div>
                    Site Location
                </div>

                <div>
                    Blast Type
                </div>

                <div>
                    Status
                </div>

                <div>
                    Actions
                </div>

            </div>


            @if (!Model.Any())
            {
                <div class="no-projects">

                    No projects yet.

                    <br />

                    Click
                    <strong>New Blast Project</strong>
                    to get started.

                </div>
            }
            else
            {

                <div id="projectList">

                    @foreach (var p in Model)
                    {
                        var status = string.IsNullOrWhiteSpace(p.Status) ? "Draft" : p.Status;
                        var statusKey = status.ToLowerInvariant();

                        <div class="project-row project-row-five"
                             data-project-name="@p.Name.ToLowerInvariant()"
                             data-project-status="@statusKey">


                            @* Project Name *@

                            <div>
                                <span class="project-name">@p.Name</span>
                            </div>


                            @* Site Location *@

                            <div class="project-location">
                                @p.SiteLocation
                            </div>


                            @* Blast Type *@

                            <div class="project-blasttype">
                                @p.BlastType
                            </div>


                            @* Status *@

                            <div>

                                <span class="project-status-badge status-@statusKey">
                                    @status
                                </span>

                            </div>


                            @* Actions *@

                            <div class="project-actions">

                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="project-action-btn view-btn"
                                   title="View Project">

                                    View

                                </a>

                                <a asp-controller="PatternDesign"
                                   asp-action="Index"
                                   asp-route-projectId="@p.Id"
                                   class="project-action-btn pattern-design-btn"
                                   title="Edit Hole Pattern">

                                    Pattern Design

                                </a>

                                <a asp-controller="Projects"
                                   asp-action="Edit"
                                   asp-route-id="@p.Id"
                                   class="project-action-btn edit-btn"
                                   title="Edit Project">

                                    Edit

                                </a>

                                <form asp-controller="Projects"
                                      asp-action="Delete"
                                      asp-route-id="@p.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this project?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="project-action delete"
                                            title="Delete Project">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </div>

                        </div>
                    }

                </div>

                <div id="noSearchResults"
                     class="no-projects"
                     style="display: none;">

                    No projects match your search.

                </div>
            }

        </div>

    }

</div>


@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
