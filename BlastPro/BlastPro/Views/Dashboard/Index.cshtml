@model List<BlastPro.Mvc.Models.Dtos.ProjectSummaryDto>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<div class="container mt-4">

    @if (ViewData["Error"] != null)
    {
        <div class="alert alert-warning">@ViewData["Error"]</div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Projects</h2>
        <a class="btn btn-primary" asp-controller="Projects" asp-action="Create">
            + New Blast Project
        </a>
    </div>

    @if (ViewData["Error"] == null && !Model.Any())
    {
        <div class="alert alert-info">
            No projects yet. Click <strong>New Blast Project</strong> to get started.
        </div>
    }
    else if (ViewData["Error"] == null)
    {
        <div class="list-group">
            @foreach (var p in Model)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">
                                <a asp-controller="Projects"
                                   asp-action="Details"
                                   asp-route-id="@p.Id"
                                   class="text-decoration-none">
                                    @p.Name
                                </a>
                            </h5>
                            <small class="text-muted">
                                @p.SiteLocation &middot; @p.BlastType
                            </small>
                        </div>
                        <span class="badge bg-secondary">@p.Status</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
