<?xml version="1.0" encoding="utf-8"?>
<!-- Chat. Optional module: UI only, the messages are sample text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <include layout="@layout/view_top_bar_menu" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <TextView
            style="@style/BlastPro.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat" />

        <TextView
            style="@style/BlastPro.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Ask questions about your notes. Chat only finds and summarises notes." />

        <!-- AI unavailable state. Hidden for now; set visibility to visible to preview it. -->
        <TextView
            android:id="@+id/banner_ai_unavailable"
            style="@style/BlastPro.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_banner"
            android:padding="12dp"
            android:text="Chat is unavailable right now. Your notes and photos still work."
            android:visibility="gone"
            tools:visibility="visible" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_bubble_user"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Which notes mention wet holes?"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="32dp"
                    android:background="@drawable/bg_bubble_answer"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="One note mentions water in holes on row C."
                        android:textColor="@color/ink_dark"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/source_note_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_source"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wet holes row C"
                            android:textColor="@color/blast_red"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Water in holes 4 to 7, consider emulsion for this row."
                            android:textColor="@color/ink_dark"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_bubble_user"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="What was decided about the vibration limit?"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="32dp"
                    android:background="@drawable/bg_bubble_answer"
                    android:padding="16dp"
                    android:text="Your notes do not contain an answer to that question."
                    android:textColor="@color/ink_dark"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/edit_question"
                style="@style/BlastPro.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="Ask about your notes"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send"
                style="@style/BlastPro.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send"
                app:icon="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
