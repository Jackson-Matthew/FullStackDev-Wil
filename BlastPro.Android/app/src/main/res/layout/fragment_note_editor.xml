<?xml version="1.0" encoding="utf-8"?>
<!-- Note editor. UI only: nothing is saved yet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <include layout="@layout/view_top_bar_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/text_heading"
                style="@style/BlastPro.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Note" />

            <TextView
                style="@style/BlastPro.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Add text and photos. Notes save on this device first." />

            <TextView
                style="@style/BlastPro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Title" />

            <EditText
                android:id="@+id/edit_title"
                style="@style/BlastPro.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Note title"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                style="@style/BlastPro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="Note" />

            <EditText
                android:id="@+id/edit_body"
                style="@style/BlastPro.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Write your note (optional for photo-only notes)"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="180dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <TextView
                style="@style/BlastPro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="Project" />

            <Spinner
                android:id="@+id/spinner_project"
                style="@style/BlastPro.Spinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:entries="@array/project_options"
                android:theme="@style/ThemeOverlay.BlastPro.Spinner" />

            <TextView
                style="@style/BlastPro.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="Photos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_take_photo"
                    style="@style/BlastPro.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Take Photo"
                    app:icon="@drawable/ic_photo_camera" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gallery"
                    style="@style/BlastPro.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gallery"
                    app:icon="@drawable/ic_photo_library" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/photo_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/thumb_1"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_thumb"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="Photo"
                        android:src="@drawable/ic_image"
                        app:tint="@color/ink_muted" />

                    <ImageButton
                        android:id="@+id/thumb_1_remove"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_dark"
                        android:contentDescription="Remove photo"
                        android:padding="7dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/white" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/thumb_2"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_thumb"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="Photo"
                        android:src="@drawable/ic_image"
                        app:tint="@color/ink_muted" />

                    <ImageButton
                        android:id="@+id/thumb_2_remove"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_dark"
                        android:contentDescription="Remove photo"
                        android:padding="7dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/white" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/thumb_3"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_thumb"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="Photo"
                        android:src="@drawable/ic_image"
                        app:tint="@color/ink_muted" />

                    <ImageButton
                        android:id="@+id/thumb_3_remove"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_dark"
                        android:contentDescription="Remove photo"
                        android:padding="7dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_no_photos"
                style="@style/BlastPro.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No photos attached."
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/BlastPro.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save"
            app:icon="@drawable/ic_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete"
            style="@style/BlastPro.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Delete"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</LinearLayout>
