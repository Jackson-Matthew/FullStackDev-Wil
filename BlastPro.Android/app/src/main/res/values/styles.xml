<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BlastPro.Heading" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BlastPro.Subtitle" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BlastPro.Label" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="BlastPro.Body" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BlastPro.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/ink_dark</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="BlastPro.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_field_dropdown</item>
        <item name="android:popupBackground">@color/white</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">40dp</item>
    </style>

    <style name="BlastPro.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blast_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="BlastPro.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

</resources>
