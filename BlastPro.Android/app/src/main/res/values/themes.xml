<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BlastProMobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blast_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Spinner dropdown: dark text on white popup so items are readable -->
    <style name="ThemeOverlay.BlastPro.Spinner" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">@color/ink_dark</item>
        <item name="android:textColorSecondary">@color/ink_dark</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnSurface">@color/ink_dark</item>
    </style>
</resources>